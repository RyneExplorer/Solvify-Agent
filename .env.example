# ===================================================
# Solvify-Agent 环境变量配置
# 优先级: config.yaml < .env 文件 < 系统环境变量
# ===================================================

# ---- 应用基础 ----
APP_ENV=development
APP_MODE=release

# ---- 服务端口 ----
SERVER_HOST=
SERVER_PORT=8080
SHUTDOWN_TIMEOUT_SECONDS=20

# ---- 日志 ----
LOG_LEVEL=info
LOG_FILENAME=logs/solvify-agent.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=30
LOG_COMPRESS=true

# ---- LLM 模型 ----
LLM_PROVIDER=mock
LLM_MODEL=mock-knowledge-assistant
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# ---- Embedding 向量化 ----
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10

# ---- RAG 检索 ----
RAG_ENABLED=true

# ---- Rerank 重排序 ----
RERANKER_ENABLED=false
RERANKER_ENDPOINT=
RERANKER_MODEL=
RERANKER_API_KEY=
RERANKER_TOP_N=3
RERANKER_TIMEOUT=10
RERANKER_SCORE_THRESHOLD=0.5

# ---- Expander 分块扩展 ----
EXPANDER_ENABLED=false
EXPANDER_WINDOW_SIZE=1
EXPANDER_MAX_CHUNK_TOKENS=1000
EXPANDER_DEDUP_THRESHOLD=0.8

# ---- 工具 ----
TOOLS_ENABLED=true

# ---- 钉钉集成 ----
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_OAUTH_REDIRECT_URI=http://localhost:5173/dingtalk/bind

# ---- 文档解析 ----
DOCUMENT_PARSER_PYTHON_PATH=python
DOCUMENT_PARSER_SCRIPT_PATH=pkg/documentparser/python/parse_document.py
DOCUMENT_PARSER_TIMEOUT_SECONDS=30

# ---- PostgreSQL ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=solvify_agent
POSTGRES_TIMEZONE=Asia/Shanghai
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_CONN_MAX_LIFETIME_MINUTES=60
POSTGRES_ENABLE_PGVECTOR=true

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
