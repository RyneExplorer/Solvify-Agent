APP_ENV=development
APP_MODE=release
SERVER_HOST=
SERVER_PORT=8080
LOG_LEVEL=info
LOG_FILENAME=logs/solvify-agent.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=30
LOG_COMPRESS=true
LLM_PROVIDER=mock
LLM_MODEL=mock-knowledge-assistant
LLM_API_KEY=
RAG_ENABLED=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=solvify_agent
POSTGRES_TIMEZONE=Asia/Shanghai
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_CONN_MAX_LIFETIME_MINUTES=60
POSTGRES_ENABLE_PGVECTOR=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
TOOLS_ENABLED=true
SHUTDOWN_TIMEOUT_SECONDS=10
