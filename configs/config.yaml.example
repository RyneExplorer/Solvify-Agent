app:
  name: solvify-agent
  version: 0.1.0
  env: development     # development / production / test
  mode: release        # debug / release / test

server:
  host: ""
  port: 8080
  shutdown_timeout_seconds: 20

# JWT 配置
jwt:
  secret: "your-jwt-secret"
  expire_hours: 24

log:
  level: info          # debug / info / warn / error
  filename: logs/solvify-agent.log
  max_size: 100         # MB
  max_backups: 7
  max_age: 30           # 天
  compress: true

# CORS 配置
cors:
  enabled: true
  allow_origins:
    - "*"
  allow_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_headers:
    - "Origin"
    - "Content-Type"
    - "Authorization"
  expose_headers: []
  allow_credentials: false
  max_age: 0

agent:
  enable_demo: true
  max_iterations: 10
  score_threshold: 0.7

# 默认 LLM 配置（系统级）
llm:
  provider: mock          # openai / deepseek / zhipu / tongyi / mock
  api_format: ""
  model: mock-knowledge-assistant
  api_key: ""
  base_url: ""
  temperature: 0.7
  max_tokens: 2000
  timeout: 30

# Embedding 向量化模型配置
embedding:
  provider: openai
  model: text-embedding-v4
  api_key: ""
  base_url: ""
  dimension: 1024

# RAG 检索配置
rag:
  enabled: true
  top_k: 3
  recall_k: 20          # Rerank 前召回量（仅 reranker.enabled=true 时生效）
  score_threshold: 0.5
  vector_weight: 0.7    # 向量检索权重
  keyword_weight: 0.3   # 关键词检索权重
  rrf_k: 60.0           # RRF 融合参数
  # Rerank 重排序（可选）
  reranker:
    enabled: false
    endpoint: ""         # 如: https://ai.gitee.com/v1/rerank
    model: ""            # 如: Qwen3-Reranker-0.6B
    api_key: ""
    top_n: 3
    timeout: 10
    score_threshold: 0.5
  # 相邻分块扩展（可选）
  expander:
    enabled: false
    window_size: 1
    max_chunk_tokens: 1000
    dedup_threshold: 0.8

# 工具配置
tools:
  enabled: true
  web_search:
    api_key: ""
    base_url: ""

# 钉钉集成配置
dingtalk:
  app_key: ""
  app_secret: ""
  oauth_redirect_uri: "http://localhost:5173/dingtalk/bind"

# 文档解析配置（docx/pdf 解析依赖 Python 脚本）
document_parser:
  python_path: "python"
  script_path: "pkg/documentparser/python/parse_document.py"
  timeout_seconds: 30

# 数据库配置
database:
  postgres:
    host: "127.0.0.1"
    port: 5432
    username: "postgres"
    password: ""
    database: "solvify_agent"
    timezone: "Asia/Shanghai"
    max_idle_conns: 5
    max_open_conns: 20
    conn_max_lifetime_minutes: 60
    enable_pgvector: true
  redis:
    host: "127.0.0.1"
    port: 6379
    password: ""
    db: 0
    pool_size: 10

# 邮箱配置（SMTP，用于验证码发送）
email:
  host: "smtp.qq.com"
  port: 465
  username: ""
  password: ""
