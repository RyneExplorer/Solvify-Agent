app:
  name: solvify-agent
  version: 0.1.0
  env: development
  mode: release

log:
  level: info
  filename: logs/solvify-agent.log
  max_size: 100
  max_backups: 7
  max_age: 30
  compress: true

agent:
  enable_demo: true

llm:
  provider: mock
  model: mock-knowledge-assistant
  api_key: ""

rag:
  enabled: true

database:
  postgres:
    host: "127.0.0.1"
    port: 5432
    username: "postgres"
    password: ""
    database: "solvify_agent"
    timezone: "Asia/Shanghai"
    max_idle_conns: 5
    max_open_conns: 20
    conn_max_lifetime_minutes: 60
    enable_pgvector: true
  redis:
    host: "127.0.0.1"
    port: 6379
    password: ""
    db: 0
    pool_size: 10

tools:
  enabled: true

server:
  host: ""
  port: 8080
  shutdown_timeout_seconds: 10
